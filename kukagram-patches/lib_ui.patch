+[[nodiscard]] QImage UniversalSprite(
+		const std::vector<QImage> &sprites,
+		int id,
+		int index) {
+	Expects(index >= 0 && index < SpritesCount);
+	{
+		const auto lock = std::lock_guard(UniversalSpritesMutex);
+		if (!sprites.empty()) {
+			return sprites[index];
+		}
+	}
+	// A cache eviction can follow ensureLoaded() before the painter reads it.
+	// Read only the needed sprite and let the caller own its pixels.
+	return (ValidateConfig(id) == ConfigResult::Good)
+		? LoadSprite(id, index)
+		: QImage();
+}
+
+[[nodiscard]] QImage RenderSourceSprite(
+		const QImage &sprite,
+		EmojiPtr emoji,
+		int size) {
+	if (sprite.isNull()) {
+		return {};
+	}
+	const auto large = kUniversalSize;
+	const auto row = emoji->row();
+	const auto column = emoji->column();
+	const auto single = QImage(
+		sprite.constBits() + (row * kImagesPerRow * large + column) * large * 4,
+		large,
+		large,
+		sprite.bytesPerLine(),
+		sprite.format());
+	// scaled() can share the atlas pixels when the requested size is equal.
+	return (size == large)
+		? single.copy()
+		: single.scaled(
+			size,
+			size,
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation);
+}
