+QImage SourceSpriteCache::render(int id, EmojiPtr emoji, int size) {
+	if (_id != id) {
+		_entries = {};
+		_id = id;
+	}
+	const auto index = emoji->sprite();
+	if (_entries[1].index == index) {
+		std::swap(_entries[0], _entries[1]);
+	}
+	if (_entries[0].index != index) {
+		if (ValidateConfig(id) != ConfigResult::Good) {
+			return {};
+		}
+		auto image = LoadSprite(id, index);
+		if (image.isNull()) {
+			return {};
+		}
+		_entries[1] = std::move(_entries[0]);
+		_entries[0] = { std::move(image), index };
+	}
+	return RenderSourceSprite(_entries[0].pixels, emoji, size);
 }
 
