+#pragma once
+
+#include "ui/emoji_config.h"
+
+#include <array>
+
+namespace Ui::Emoji {
+
+// Used only on the background emoji image loader's queue.
+class SourceSpriteCache final {
+public:
+	[[nodiscard]] QImage render(int id, EmojiPtr emoji, int size);
+
+private:
+	struct Entry {
+		QImage pixels;
+		int index = -1;
+	};
+	std::array<Entry, 2> _entries;
+	int _id = -1;
+};
+
+} // namespace Ui::Emoji
